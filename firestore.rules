rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isGoogleAdmin() {
      return request.auth != null && 
             request.auth.token.email != null && 
             request.auth.token.email.lower() == 'mohammednanabail@gmail.com';
    }

    // المنتجات: القراءة للجميع، وتحديث عدادات المشاهدات وضغطات واتساب فقط متاح للزوار
    match /products/{productId} {
      allow read: if true;
      allow create, delete: if true;
      allow update: if isGoogleAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views', 'waClicks'])
      ) || true;
    }

    // إحصائيات الزيارات الحقيقية للمتجر (الزيارات الإجمالية وزيارات اليوم)
    match /stats/{statId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isGoogleAdmin();
    }

    // بيانات اعتماد دخول المدير
    match /admin_auth/{authId} {
      allow read, write: if true;
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if true;
    }

    match /ads/{adId} {
      allow read: if true;
      allow write: if true;
    }

    match /testimonials/{testiId} {
      allow read: if true;
      allow write: if true;
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }
  }
}

